CREATE OR REPLACE FUNCTION pulse.test_nested() RETURNS integer
LANGUAGE plpgsql
AS $$
BEGIN
	RETURN (SELECT 42);
END;
$$;
SET pulse.track = top;
SELECT pulse.reset();
 reset 
-------
 
(1 row)

SELECT pulse.test_nested();
 test_nested 
-------------
          42
(1 row)

SELECT count(*) = 2 AS top_level_only FROM pulse.queries();
 top_level_only 
----------------
 t
(1 row)

SET pulse.track = 'all';
SELECT pulse.reset();
 reset 
-------
 
(1 row)

SELECT pulse.test_nested();
 test_nested 
-------------
          42
(1 row)

SELECT count(*) = 3 AS nested_statements_tracked FROM pulse.queries();
 nested_statements_tracked 
---------------------------
 t
(1 row)

RESET pulse.track;
SELECT 1;
 ?column? 
----------
        1
(1 row)

